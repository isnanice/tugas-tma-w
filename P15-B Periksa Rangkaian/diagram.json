{
    "version": 1,
    "author": "Isna Ima Solekhah",
    "editor": "wokwi",
    "parts": [
      { "type": "board-esp32-devkit-c-v4", "id": "esp", "top": 0, "left": 0, "attrs": {} },
      { "type": "wokwi-pushbutton", "id": "btn1", "top": -40, "left": -150, "attrs": { "color": "yellow", "label": "GPIO12" } },
      { "type": "wokwi-resistor", "id": "rPull", "top": -90, "left": -140, "attrs": { "value": "10000" } },
      { "type": "wokwi-potentiometer", "id": "pot1", "top": 60, "left": -170, "attrs": { "label": "GPIO26 (ADC2)" } },
      { "type": "wokwi-led", "id": "led1", "top": 40, "left": 180, "attrs": { "color": "red", "label": "Tanpa R" } }
