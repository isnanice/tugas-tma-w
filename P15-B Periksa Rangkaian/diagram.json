      [ "pot1:VCC", "esp:3V3", "red", [ "v30", "h60" ] ],
      [ "pot1:SIG", "esp:26", "purple", [ "v10", "h70" ] ],
      [ "esp:4", "led1:A", "red", [ "h0" ] ],
      [ "led1:C", "esp:GND.2", "black", [ "v0" ] ]
    ],
    "dependencies": {}
